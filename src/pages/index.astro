      "placeholder": "[ screenshot de la app aquí ]",
      "meta.title": "soofShoot — Captura, edita y lleva tus capturas a otro nivel",
      "meta.desc": "Captura, edita y lleva tus capturas a otro nivel con soofShoot. Edición, mockups, OCR y más. Sin cuentas, sin límites.",
      "aria.theme": "Cambiar tema",
      "aria.lang": "Idioma",
