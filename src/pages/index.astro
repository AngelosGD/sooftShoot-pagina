---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div id="nav-sentinel" aria-hidden="true"></div>

  <header id="site-nav" class="fixed top-4 inset-x-0 z-50 px-4">
    <div class="nav-capsule mx-auto max-w-3xl">
      <a href="/" class="flex items-center gap-2.5 text-sm font-semibold tracking-tight">
        <img src="/logosintexto.png" alt="soofShoot" width="28" height="28" class="brand-mark size-7 object-contain" loading="eager" />
        soofShoot
      </a>
      <nav class="hidden sm:flex items-center gap-1 text-sm text-muted">
        <a href="#features" class="nav-pill" data-i18n="nav.features">Features</a>
        <a href="#download" class="nav-pill" data-i18n="nav.download">Download</a>
      </nav>
      <div class="flex items-center gap-2">
        <div class="lang-switch" role="group" aria-label="Language">
          <button type="button" class="lang-btn active" data-lang="en" aria-pressed="true">EN</button>
          <button type="button" class="lang-btn" data-lang="es" aria-pressed="false">ES</button>
        </div>
        <button id="theme-toggle" type="button" aria-label="Toggle theme" class="theme-toggle">
          <svg class="icon-sun size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 3v1.5M12 20.25v1.5M4.22 4.22l1.06 1.06M18.72 18.72l1.06 1.06M3 12h1.5M20.25 12H21.75M4.22 19.78l1.06-1.06M18.72 5.28l1.06-1.06M12 8.25A3.75 3.75 0 1 1 12 15.75A3.75 3.75 0 0 1 12 8.25Z"/></svg>
          <svg class="icon-moon size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21.752 15.002A9.718 9.718 0 0 1 12 21.75 9.75 9.75 0 0 1 12 2.25c0 1.33.266 2.597.748 3.752A5.25 5.25 0 0 0 21.752 15.002Z"/></svg>
        </button>
        <a href="https://github.com/AngelosGD/soofShoot" class="gh-chip" target="_blank" rel="noopener noreferrer">
          GitHub
          <svg class="size-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17 17 7m0 0H8m9 0v9"/></svg>
        </a>
      </div>
    </div>
  </header>

  <main>
    <section class="relative min-h-[100dvh] overflow-hidden flex items-center justify-center pt-32 pb-24 text-center">
      <div class="absolute inset-0" aria-hidden="true">
        <div class="orb-layer">
          <div class="orb orb-a"></div>
          <div class="orb orb-b"></div>
          <div class="orb orb-c"></div>
        </div>
        <div class="dot-grid"></div>
        <div class="hero-lines" aria-hidden="true"></div>
        <div class="hero-curves" aria-hidden="true">
          <div class="hero-curve hero-curve--a"></div>
          <div class="hero-curve hero-curve--b"></div>
        </div>
        <div class="hero-rings" aria-hidden="true">
          <div class="hero-ring hero-ring--1"></div>
          <div class="hero-ring hero-ring--2"></div>
        </div>
        <div class="hero-scan" aria-hidden="true"></div>
      </div>
      <div class="relative mx-auto max-w-4xl px-4 sm:px-6">
        <p class="hero-e eyebrow mb-6" style="animation-delay:0s">Screen Capture · Reimagined</p>
        <h1 class="hero-e text-5xl sm:text-6xl lg:text-7xl font-semibold tracking-[-0.04em] leading-[1.04] mb-6" style="animation-delay:0.1s" data-i18n="hero.title" data-i18n-html>
          The cleanest way to<br class="hidden lg:block" /> capture and present ideas
        </h1>
        <p class="hero-e text-base sm:text-lg text-muted leading-relaxed max-w-[58ch] mx-auto mb-10" style="animation-delay:0.2s" data-i18n="hero.sub" data-i18n-html>
          Select any region of your screen, refine it with canvas tools,
          overlay device mockups, extract text with OCR and export to PNG, PDF or straight to Word.
          <span class="text-foreground"> No accounts, no limits, no distractions.</span>
        </p>
        <div class="hero-e flex flex-wrap justify-center gap-3" style="animation-delay:0.3s">
          <a href="#download" class="group inline-flex items-center gap-2 px-7 py-3 rounded-full bg-foreground text-background font-medium text-sm cursor-pointer transition-all duration-300 ease-out hover:-translate-y-0.5 hover:shadow-[0_10px_40px_-10px_rgb(var(--accent-rgb)/0.5)] active:translate-y-0 active:scale-[0.97]">
            <span data-i18n="hero.ctaPrimary">Download free</span>
            <svg class="size-4 transition-transform duration-300 ease-out group-hover:translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3"/></svg>
          </a>
          <a href="#features" class="inline-flex items-center px-7 py-3 rounded-full border border-border text-sm font-medium transition-all duration-300 ease-out hover:-translate-y-0.5 hover:border-foreground/15 hover:bg-[var(--wash)] active:translate-y-0 active:scale-[0.97]" data-i18n="hero.ctaSecondary">
            Learn more
          </a>
        </div>
      </div>
    </section>

    <section aria-label="Key features" class="marquee-strip relative border-y border-border py-5 overflow-hidden" data-i18n-aria="marquee.aria">
      <div class="marquee-track">
        <ul class="marquee-group">
          <li class="marquee-item" data-i18n="marquee.shortcuts">Custom shortcuts</li>
          <li class="marquee-item" data-i18n="marquee.canvas">Canvas editing</li>
          <li class="marquee-item" data-i18n="marquee.mockups">3D Mockups</li>
          <li class="marquee-item" data-i18n="marquee.ocr">OCR + Code</li>
          <li class="marquee-item" data-i18n="marquee.export">Versatile export</li>
        </ul>
        <ul class="marquee-group" aria-hidden="true">
          <li class="marquee-item">Custom shortcuts</li>
          <li class="marquee-item">Canvas editing</li>
          <li class="marquee-item">3D Mockups</li>
          <li class="marquee-item">OCR + Code</li>
          <li class="marquee-item">Versatile export</li>
        </ul>
      </div>
    </section>

    <section id="features" class="relative py-28 sm:py-36 overflow-hidden">
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="features-glow"></div>
        <div class="features-glow--side features-glow--left"></div>
        <div class="features-glow--side features-glow--right"></div>
        <div class="features-grid"></div>
      </div>
      <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
        <div class="reveal max-w-2xl mx-auto text-center mb-14 sm:mb-20" style="--reveal-delay:0ms">
          <p class="eyebrow mb-5 inline-block" data-i18n="features.eyebrow">Features</p>
          <h2 class="text-3xl sm:text-5xl font-semibold tracking-[-0.03em] leading-[1.08]" data-i18n="features.title">Everything you need for flawless captures</h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-4 lg:gap-5">
          <article class="reveal spot-card bento-card group p-6 sm:p-7 grid lg:grid-cols-[0.78fr_1.22fr] gap-5 sm:col-span-2 lg:col-span-8" style="--reveal-delay:60ms">
            <div class="flex flex-col items-start justify-center">
              <div class="bento-icon bento-icon-accent mb-5">
                <svg class="size-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3"/></svg>
              </div>
              <h3 class="font-semibold text-[1.15rem] leading-tight mb-2.5" data-i18n="card.edit.title">Complete editing</h3>
              <p class="text-[13.5px] text-muted leading-relaxed max-w-[32ch]" data-i18n="card.edit.desc">Background, padding, filters, borders, shadows, rounded corners, 3D rotation and precise cropping.</p>
            </div>
            <figure class="shot-media aspect-[16/9] flex items-center justify-center bg-[var(--surface)] overflow-hidden">
              <img src="/complete-editing.png" alt="soofShoot canvas editor — background, padding, 3D and filters" width="1952" height="1112" loading="lazy" decoding="async" class="w-full h-full object-contain p-1.5" />
            </figure>
          </article>

          <article class="reveal spot-card bento-card group p-7 sm:p-7 flex flex-col sm:col-span-2 lg:col-span-4" style="--reveal-delay:120ms">
            <div class="bento-icon bento-icon-accent mb-5">
              <svg class="size-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="m9.53 16.122-3.475 3.475m0 0a1.5 1.5 0 0 1-2.12-2.12l3.475-3.475m2.12 2.12a3.375 3.375 0 0 0 3.708-4.092m0 0a3.375 3.375 0 0 0-4.092-3.708m0 0a3.375 3.375 0 0 0-3.708 4.092m0 0a3.375 3.375 0 0 0 4.092 3.708m3.708-4.092 3.475-3.475m0 0a1.5 1.5 0 0 1 2.12 2.12l-3.475 3.475"/></svg>
            </div>
            <h3 class="font-semibold text-[1.05rem] leading-tight mb-2" data-i18n="card.mockup.title">Pro mockups</h3>
            <p class="text-[13px] text-muted leading-relaxed mb-6" data-i18n="card.mockup.desc">Overlay your captures on iPhone, iPad or Mac. Perfect for presentations and portfolios.</p>
            <figure class="shot-media mt-auto">
              <img src="/pro-mockups.png" alt="soofShoot mockup — iPhone 15 Pro preview" width="1952" height="1112" loading="lazy" decoding="async" />
            </figure>
          </article>

          <article class="reveal spot-card bento-card group p-6 lg:col-span-5" style="--reveal-delay:180ms">
            <span class="num-tag">01</span>
            <h3 class="font-semibold text-[1.05rem] leading-tight mt-4 mb-2" data-i18n="card.capture.title">Smart capture</h3>
            <p class="text-[13px] text-muted leading-relaxed" data-i18n="card.capture.desc">Select any region with customizable shortcuts. Capture instantly, no interruptions.</p>
          </article>

          <article class="reveal spot-card bento-card group p-6 lg:col-span-3" style="--reveal-delay:240ms">
            <span class="num-tag">02</span>
            <h3 class="font-semibold text-[1.05rem] leading-tight mt-4 mb-2" data-i18n="card.ocr.title">OCR + Code</h3>
            <p class="text-[13px] text-muted leading-relaxed" data-i18n="card.ocr.desc">Extract text with Tesseract.js. Auto-detects and formats code to copy instantly.</p>
          </article>

          <article class="reveal spot-card bento-card group p-6 sm:col-span-2 lg:col-span-4" style="--reveal-delay:300ms">
            <span class="num-tag">03</span>
            <h3 class="font-semibold text-[1.05rem] leading-tight mt-4 mb-2" data-i18n="card.export.title">Versatile export</h3>
            <p class="text-[13px] text-muted leading-relaxed" data-i18n="card.export.desc">PNG, JPEG or WebP. Batch-export to PDF, copy to clipboard or insert straight into Word.</p>
          </article>

          <a href="#download" class="reveal spot-card bento-card group p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center gap-5 sm:gap-7 sm:col-span-2 lg:col-span-12 cursor-pointer" style="--reveal-delay:360ms">
            <div class="bento-icon">
              <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m9 14.25 6-6m4.5-3.493V21.75l-3.75-1.5-3.75 1.5-3.75-1.5-3.75 1.5V4.5c0-.75.188-1.457.518-2.07m5.732 0A2.25 2.25 0 0 1 16.5 3.75"/></svg>
            </div>
            <div class="flex-1 sm:max-w-[62ch]">
              <h3 class="font-semibold text-lg mb-1" data-i18n="card.free.title">100% free</h3>
              <p class="text-sm text-muted leading-relaxed" data-i18n="card.free.desc">No accounts, no subscriptions, no hidden limits. Download and start instantly.</p>
            </div>
            <span class="inline-flex items-center gap-2 font-mono text-sm text-accent shrink-0">
              <span data-i18n="card.free.cta">Download free</span>
              <svg class="size-4 transition-transform duration-300 ease-out group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg>
            </span>
          </a>
        </div>
      </div>
    </section>

    <section id="download" class="relative py-28 sm:py-40 overflow-hidden">
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="download-grid"></div>
        <div class="download-glow"></div>
        <div class="download-curves" aria-hidden="true">
          <div class="download-curve download-curve--a"></div>
          <div class="download-curve download-curve--b"></div>
        </div>
      </div>
      <div class="pulse-orb top-1/2 left-1/2 -ml-[340px] -mt-[340px] size-[680px]" aria-hidden="true"></div>
      <div class="reveal relative mx-auto max-w-3xl px-4 sm:px-6 text-center" style="--reveal-delay:0ms">
        <p class="eyebrow mb-5 inline-block" data-i18n="download.eyebrow">Get it now</p>
        <h2 class="text-4xl sm:text-6xl font-semibold tracking-[-0.04em] leading-[1.05] mb-5" data-i18n="download.title">Download soofShoot</h2>
        <p class="text-muted max-w-md mx-auto mb-2 leading-relaxed" data-i18n="download.sub">Available for Windows — choose your architecture.</p>
        <p class="text-[11px] tracking-wide font-mono text-muted/70 mb-10">x32 · x64</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/soofshoot_0.1.0_x86-x32-setup.exe" download="soofShoot-x32-setup.exe" class="group inline-flex items-center gap-2.5 px-7 py-3.5 rounded-full border border-border bg-surface text-foreground font-medium text-sm transition-all duration-300 ease-out hover:-translate-y-0.5 hover:border-foreground/15 hover:bg-[var(--wash)] active:translate-y-0 active:scale-[0.97]">
            <svg class="size-4 opacity-70" fill="currentColor" viewBox="0 0 24 24"><path d="M3 5.5A1.5 1.5 0 0 1 4.5 4h15A1.5 1.5 0 0 1 21 5.5v13A1.5 1.5 0 0 1 19.5 20h-15A1.5 1.5 0 0 1 3 18.5v-13ZM5 8.5v7a.5.5 0 0 0 .5.5h13a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.5-.5h-13A.5.5 0 0 0 5 8.5Zm3.25 1.5a.75.75 0 0 1 .75-.75h.5a.75.75 0 0 1 0 1.5h-.5a.75.75 0 0 1-.75-.75Zm4 0a.75.75 0 0 1 .75-.75h.5a.75.75 0 0 1 0 1.5h-.5a.75.75 0 0 1-.75-.75Z"/></svg>
            <span data-i18n="download.btn32">Windows x32</span>
            <span class="text-[11px] font-mono opacity-60">32-bit</span>
          </a>
          <a href="/soofshoot_0.1.0_x64-setup.exe" download="soofShoot-x64-setup.exe" class="group inline-flex items-center gap-2.5 px-8 py-4 rounded-full bg-foreground text-background font-medium text-sm cursor-pointer transition-all duration-300 ease-out hover:-translate-y-0.5 hover:shadow-[0_12px_48px_-12px_rgb(var(--accent-rgb)/0.55)] active:translate-y-0 active:scale-[0.97]">
            <svg class="size-5 transition-transform duration-300 ease-out group-hover:-translate-y-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M3.5 2.75a.75.75 0 0 1 .75-.75h12.5a.75.75 0 0 1 .53.22l4 4a.75.75 0 0 1 .22.53v13.5a.75.75 0 0 1-.75.75H4.25a.75.75 0 0 1-.75-.75V2.75Zm2.25.75v17h12.5V7.56L14.44 3.5H5.75Z"/><path d="M10.5 12.44V8.25a.75.75 0 0 1 1.5 0v4.19l1.72-1.72a.75.75 0 1 1 1.06 1.06l-3 3a.75.75 0 0 1-1.06 0l-3-3a.75.75 0 1 1 1.06-1.06l1.72 1.72Z"/></svg>
            <span data-i18n="download.btn64">Windows x64</span>
            <span class="text-[11px] font-mono opacity-70">64-bit</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="relative border-t border-border overflow-hidden">
    <p class="footer-mark" aria-hidden="true">soofShoot</p>
    <div class="relative border-t border-border">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-8">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-muted">
          <div class="flex items-center gap-2.5">
            <img src="/logosintexto.png" alt="soofShoot" width="24" height="24" class="brand-mark size-6 object-contain" loading="lazy" />
            <span>soofShoot</span>
          </div>
          <p data-i18n="footer.copy" data-i18n-html>&copy; <span data-year></span> soofShoot. Made with dedication.</p>
          <div class="flex items-center gap-7">
            <a href="https://github.com/AngelosGD/soofShoot" class="nav-link" target="_blank" rel="noopener noreferrer">GitHub</a>
            <button type="button" class="nav-link" data-contact-open data-i18n="footer.contact" style="background:none;border:0;padding:0;font:inherit;cursor:pointer">Contact</button>
          </div>
        </div>
      </div>
    </div>
  </footer>

  <div id="lightbox" class="lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Image preview">
    <div class="lightbox-backdrop" data-close></div>
    <img class="lightbox-img" src="" alt="" />
    <button type="button" class="lightbox-close" aria-label="Close" data-close>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>

  <div id="contact-modal" class="contact-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="contact-title">
    <div class="contact-backdrop" data-close-contact></div>
    <div class="contact-card">
      <button type="button" class="contact-close" aria-label="Close" data-close-contact>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
      <div class="pr-8">
        <p class="eyebrow mb-3" style="font-size:0.68rem" data-i18n="contact.eyebrow">Get in touch</p>
        <h2 id="contact-title" class="text-2xl font-semibold tracking-tight mb-1.5" data-i18n="contact.title">Contact us</h2>
        <p class="text-sm text-muted leading-relaxed mb-6" data-i18n="contact.sub">Have a question or feedback? Send us a message.</p>
      </div>
      <form id="contact-form" class="space-y-4" novalidate>
        <div class="contact-field">
          <label for="contact-name" class="contact-label" data-i18n="contact.nameLabel">Name</label>
          <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="80" class="contact-input" data-i18n-placeholder="contact.namePh" placeholder="Your name" />
        </div>
        <div class="contact-field">
          <label for="contact-email" class="contact-label" data-i18n="contact.emailLabel">Email</label>
          <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="120" class="contact-input" data-i18n-placeholder="contact.emailPh" placeholder="you@example.com" />
        </div>
        <div class="contact-field">
          <label for="contact-message" class="contact-label" data-i18n="contact.msgLabel">Message</label>
          <textarea id="contact-message" name="message" required maxlength="4000" class="contact-textarea" data-i18n-placeholder="contact.msgPh" placeholder="How can we help?"></textarea>
        </div>
        <p id="contact-status" class="text-sm min-h-[1.25rem]" aria-live="polite"></p>
        <button type="submit" id="contact-submit" class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-foreground text-background font-medium text-sm transition-all duration-300 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] disabled:opacity-60 disabled:cursor-not-allowed">
          <span data-i18n="contact.send">Send message</span>
          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
        <p class="text-[11px] text-muted text-center" data-i18n="contact.foot">We’ll reply to your email shortly.</p>
      </form>
    </div>
  </div>
</Layout>

<script>
  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // -------- i18n --------
  const i18n = {
    en: {
      "nav.features": "Features",
      "nav.download": "Download",
      "hero.title": "The cleanest way to<br class=\"hidden lg:block\" /> capture and present ideas",
      "hero.sub": "Select any region of your screen, refine it with canvas tools,\n          overlay device mockups, extract text with OCR and export to PNG, PDF or straight to Word.\n          <span class=\"text-foreground\"> No accounts, no limits, no distractions.</span>",
      "hero.ctaPrimary": "Download free",
      "hero.ctaSecondary": "Learn more",
      "marquee.shortcuts": "Custom shortcuts",
      "marquee.canvas": "Canvas editing",
      "marquee.mockups": "3D Mockups",
      "marquee.ocr": "OCR + Code",
      "marquee.export": "Versatile export",
      "features.eyebrow": "Features",
      "features.title": "Everything you need for flawless captures",
      "card.edit.title": "Complete editing",
      "card.edit.desc": "Background, padding, filters, borders, shadows, rounded corners, 3D rotation and precise cropping.",
      "card.mockup.title": "Pro mockups",
      "card.mockup.desc": "Overlay your captures on iPhone, iPad or Mac. Perfect for presentations and portfolios.",
      "card.capture.title": "Smart capture",
      "card.capture.desc": "Select any region with customizable shortcuts. Capture instantly, no interruptions.",
      "card.ocr.title": "OCR + Code",
      "card.ocr.desc": "Extract text with Tesseract.js. Auto-detects and formats code to copy instantly.",
      "card.export.title": "Versatile export",
      "card.export.desc": "PNG, JPEG or WebP. Batch-export to PDF, copy to clipboard or insert straight into Word.",
      "card.free.title": "100% free",
      "card.free.desc": "No accounts, no subscriptions, no hidden limits. Download and start instantly.",
      "card.free.cta": "Download free",
      "download.eyebrow": "Get it now",
      "download.title": "Download soofShoot",
      "download.sub": "Available for Windows — choose your architecture.",
      "download.btn32": "Windows x32",
