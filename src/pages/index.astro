      "card.ocr.title": "OCR + Code",
      "card.ocr.desc": "Extract text with Tesseract.js. Auto-detects and formats code to copy instantly.",
      "card.export.title": "Versatile export",
      "card.export.desc": "PNG, JPEG or WebP. Batch-export to PDF, copy to clipboard or insert straight into Word.",
      "card.free.title": "100% free",
      "card.free.desc": "No accounts, no subscriptions, no hidden limits. Download and start instantly.",
      "card.free.cta": "Download free",
      "download.eyebrow": "Get it now",
      "download.title": "Download soofShoot",
      "download.sub": "Available for Windows. Coming soon on macOS.",
      "download.btnWin": "Download for Windows",
      "download.btnMac": "Coming soon on macOS",
      "footer.copy": "© <span data-year></span> soofShoot. Made with dedication.",
      "footer.contact": "Contact",
      "placeholder": "[ app screenshot here ]",
      "meta.title": "soofShoot — Capture, edit and elevate your screenshots",
      "meta.desc": "Capture, edit and elevate your screenshots with soofShoot. Canvas editing, mockups, OCR and more. No accounts, no limits.",
      "aria.theme": "Toggle theme",
      "aria.lang": "Language",
    },
    es: {
      "nav.features": "Funciones",
      "nav.download": "Descargar",
      "hero.title": "La forma más limpia de<br class=\"hidden lg:block\" /> capturar y presentar ideas",
      "hero.sub": "Seleccioná cualquier región de tu pantalla, editála al detalle con herramientas de canvas,\n          superponé mockups de dispositivos, extraé texto con OCR y exportá a PNG, PDF o directo a Word.\n          <span class=\"text-foreground\"> Sin cuentas, sin límites, sin distracciones.</span>",
